generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS_OWNER
  MODERATOR
  ADMIN
}

enum ContentStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum VoteTarget {
  REVIEW
  COMMENT
}

enum VoteValue {
  UP
  DOWN
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id              String          @id @default(cuid())
  name            String?
  username        String?         @unique
  email           String          @unique
  emailVerified   DateTime?
  image           String?
  bio             String?
  location        String?
  reputation      Int             @default(0)
  role            Role            @default(USER)
  bannedAt        DateTime?
  createdAt       DateTime        @default(now())
  reviews         Review[]
  comments        Comment[]
  votes           Vote[]
  reports         Report[]
  ownedBusinesses Business[]      @relation("Owner")
  forumPosts      ForumPost[]     @relation("ForumPosts")
  forumComments   ForumComment[]  @relation("ForumComments")
  forumReactions  ForumReaction[] @relation("ForumReactions")
  accounts        Account[]
  sessions        Session[]
}

model Business {
  id            String             @id @default(cuid())
  name          String
  category      String
  tags          String[]
  address       String
  city          String
  state         String
  zip           String
  phone         String?
  website       String?
  hours         Json?
  description   String?
  claimed       Boolean            @default(false)
  ownerId       String?
  owner         User?              @relation("Owner", fields: [ownerId], references: [id])
  averageRating Float              @default(0)
  reviewCount   Int                @default(0)
  photos        Json?
  createdAt     DateTime           @default(now())
  reviews       Review[]
  responses     BusinessResponse[]

  @@index([city, state])
  @@index([category])
}

model Review {
  id          String             @id @default(cuid())
  businessId  String
  userId      String
  rating      Int
  title       String
  body        String
  photos      Json?
  status      ContentStatus      @default(PUBLISHED)
  upvotes     Int                @default(0)
  downvotes   Int                @default(0)
  createdAt   DateTime           @default(now())
  editedAt    DateTime?
  business    Business           @relation(fields: [businessId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  comments    Comment[]
  votes       Vote[]
  responses   BusinessResponse[]

  @@unique([businessId, userId])
  @@index([businessId, status])
}

model Comment {
  id        String    @id @default(cuid())
  reviewId  String
  userId    String
  parentId  String?
  body      String
  upvotes   Int       @default(0)
  createdAt DateTime  @default(now())
  review    Review    @relation(fields: [reviewId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  parent    Comment?  @relation("Thread", fields: [parentId], references: [id])
  replies   Comment[] @relation("Thread")
  votes     Vote[]
}

model Vote {
  id        String     @id @default(cuid())
  userId    String
  target    VoteTarget
  value     VoteValue
  reviewId  String?
  commentId String?
  user      User       @relation(fields: [userId], references: [id])
  review    Review?    @relation(fields: [reviewId], references: [id])
  comment   Comment?   @relation(fields: [commentId], references: [id])

  @@unique([userId, target, reviewId])
  @@unique([userId, target, commentId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  target     VoteTarget
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reporter   User         @relation(fields: [reporterId], references: [id])
}

model BusinessResponse {
  id          String   @id @default(cuid())
  businessId  String
  reviewId    String
  responderId String
  body        String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  review      Review   @relation(fields: [reviewId], references: [id])
}

model ForumPost {
  id        String          @id @default(cuid())
  topic     String
  body      String
  authorId  String
  createdAt DateTime        @default(now())
  author    User            @relation("ForumPosts", fields: [authorId], references: [id], onDelete: Cascade)
  comments  ForumComment[]
  reactions ForumReaction[]

  @@index([createdAt])
}

model ForumComment {
  id        String    @id @default(cuid())
  body      String
  postId    String
  authorId  String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation("ForumComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model ForumReaction {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation("ForumReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
